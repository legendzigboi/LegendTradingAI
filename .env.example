# ============================================================
# LEGEND TRADING AI — ENVIRONMENT VARIABLES (TEMPLATE)
# ============================================================
# This file is a TEMPLATE. Copy it to `.env` and fill in
# real values. NEVER commit `.env` to Git.
#
#   cp .env.example .env
#
# ============================================================

# ------------------------------------------------------------
# TELEGRAM (bot alerts + control)
# ------------------------------------------------------------
# Get from @BotFather on Telegram:
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal chat ID (from getUpdates):
TELEGRAM_CHAT_ID=your_chat_id_here

# ------------------------------------------------------------
# MARKET DATA (add when needed)
# ------------------------------------------------------------
# Binance public API needs NO key — leave blank for now.
# Add later if we use a paid provider (Polygon, TwelveData, etc.)
DATA_API_KEY=

# ------------------------------------------------------------
# APP ENVIRONMENT
# ------------------------------------------------------------
ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------
# Local SQLite path for signal logs and paper trades.
DB_PATH=data/legend.db
